# URL del proyecto
NEXT_PUBLIC_SUPABASE_URL=

NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Solo en el servidor y en los scripts (siembra, pruebas). Nunca con NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# Dirección pública del sistema: adonde vuelve el login (debe estar en las
# "Redirect URLs" de Supabase). Por defecto, http://localhost:3000.
URL_DEL_SITIO=http://localhost:3000

# Contraseña de los usuarios *@efsrt.test (solo pruebas automáticas).
CLAVE_USUARIOS_PRUEBA=

# Tus cuentas reales para probar a mano y grabar el video (bun run db:sembrar).
# Los alias de Gmail (tucorreo+mesapartes@gmail.com) entran con el enlace al correo.
CUENTA_ESTUDIANTE=
CUENTA_EGRESADA=
CUENTA_MESA_PARTES=
CUENTA_COORDINACION=
CUENTA_DOCENTE=
CUENTA_BIENESTAR=

# Notificaciones al estudiante (Fase 9, D55). "gmail" envía de verdad por el
# SMTP de Gmail (D48); cualquier otro valor solo imprime el correo en la consola.
NOTIFICACIONES_ENVIO=consola
# Cuenta de Gmail que envía y su contraseña de aplicación (la misma del SMTP de Supabase).
CORREO_REMITENTE=
GMAIL_CLAVE_APLICACION=
